# ==============================================================================
# NimbleVoice Backend — Environment Configuration Template
# Copy to .env for local development. Never commit .env or real credentials.
# ==============================================================================

# Server & Docs
PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080
SWAGGER_ENABLED=true

# PostgreSQL Database (DB_PASSWORD is required; no hardcoded fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_local_postgres_password
DB_NAME=enterprise_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Dhaka
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Authentication (JWT_SECRET is required; >= 32 random chars recommended, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_random_hex_secret_at_least_32_chars

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# CORS & Reverse Proxy Allowlists
# CORS_ALLOWED_ORIGINS takes precedence over legacy FRONTEND_ORIGINS and FRONTEND_URL
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Optional comma-separated trusted proxy IPs/CIDRs (empty disables trusting X-Forwarded-For)
TRUSTED_PROXIES=

# WebRTC ICE / Optional Coturn REST Credentials
# Comma-separated STUN URLs (order preserved)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Set TURN_ENABLED=true only when Coturn is configured; leave TURN_URLS and TURN_SHARED_SECRET empty when disabled
TURN_ENABLED=false
TURN_URLS=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional Redis (disabled by default for single-instance in-memory presence)
REDIS_ENABLED=false
REDIS_URL=

# Room Capacity & Presence Lifecycle
ROOM_DEFAULT_MAX_PARTICIPANTS=6
ROOM_IDLE_GRACE_SECONDS=30
PRESENCE_PING_INTERVAL=25s
PRESENCE_PONG_TIMEOUT=60s
