# Application
PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=nimble_voice
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Dhaka
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# JWT Authentication
# Generate a long, random value. Never use a real secret in this example file.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_GUEST_TOKEN_TTL_MINUTES=240

# WebRTC ICE / STUN
# TURN is optional. With TURN_ENABLED=false, clients use STUN-only configuration.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional Coturn TURN configuration
TURN_ENABLED=false
TURN_URLS=
# coturn_rest is recommended for production; static is for local testing only.
TURN_CREDENTIAL_MODE=coturn_rest
# Keep this shared secret on the Go backend only. Never expose it to the browser.
TURN_SHARED_SECRET=
# Static credentials are a development fallback and are visible to clients.
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Local file uploads (no external storage required)
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_MESSAGE=10
MAX_MESSAGE_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm,video/quicktime

# Room lifecycle and mesh capacity
ROOM_EMPTY_GRACE_SECONDS=30
ROOM_CLEANUP_INTERVAL_SECONDS=60
ROOM_DEFAULT_MAX_PARTICIPANTS=6

# Socket.IO / Presence
SOCKET_PING_INTERVAL_SECONDS=25
SOCKET_PING_TIMEOUT_SECONDS=20
SOCKET_MAX_PAYLOAD_MB=2
PRESENCE_HEARTBEAT_SECONDS=30
PRESENCE_STALE_AFTER_SECONDS=90

# Optional Redis (not required for a single backend instance)
REDIS_ENABLED=false
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=nimblevoice:

# Logging and security
LOG_LEVEL=debug
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_CIDRS=
